import numpy as np


def produit_scalaire(G, rj):
    """
    G :  (h,k,l) vecteur du réseau réciproque
    rj : (x,y,z) position de l'atome j
    """
    G = np.array(G)
    rj = np.array(rj)
    return np.dot(G, rj)


def norme_carre(G):
#Renvoie |G|^2
    G = np.array(G)
    return np.dot(G, G)


