B_database = {
    "C": {300: 1.0},  # atome 0
    1: {300: 0.8},  # atome 1
    2: {300: 1.2},  # etc.
}


def Bj(T, j):
    """
    Renvoie le facteur B_j pour un atome j à température T
    """
    try:
        return B_database[j][T]
    except KeyError:
        raise ValueError(f"B_j non défini pour j={j}, T={T}")


def fonction_exp_DW(T, G, j):
    """
    Renvoie exp(-B_j(T,j) * |G|^2)
    """
    B = Bj(T, j)
    G2 = norme_carre(G)
    return np.exp(-B * G2)


def fonction_expiGr(G, rj):
    """
    Renvoie exp(i G.rj)
    """
    phase = produit_scalaire(G, rj)
    return np.exp(1j * phase)


def Facteur_de_structure(G, T, liste_atomes, liste_FD):
    """
    G : vecteur réciproque
    T : température
    liste_atomes : liste de dictionnaires avec au moins {'position': (x,y,z)}
    liste_FD : liste des f_j(G) correspondants

    Retourne F(G)
    """
    F = 0 + 0j  # complexe

    for j, atome in enumerate(liste_atomes):
        rj = atome["position"]
        fj = liste_FD[j]

        DW = fonction_exp_DW(T, G, j)
        phase = fonction_expiGr(G, rj)

        F += fj * DW * phase

    return F