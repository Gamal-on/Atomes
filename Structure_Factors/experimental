import numpy as np
import math


#La seule dépendance en Temperature se situe dans le facteur de Debye Waller


def produit_scalaire(G, rj):
    """
    G :  (h,k,l) vecteur du réseau réciproque
    rj : (x,y,z) position de l'atome j
    """
    G = np.array(G)
    rj = np.array(rj)
    return np.dot(G, rj)

#base de données B_j(T)
# Du type : {j: {B_value}} avec T=123K et B_value en Bohr^2
#Base de données U_j(T=123K)
#Cf article Birkedal, les coeff de Uij sont parfois nuls + symétrie de la matrice U 
#qui vient du fait que les atomes sont dans des positions de symétrie particulières (ex: C à l'origine)


scale = 1e-4

U = {
    "C": scale * np.array([
        [147,  1,   0.0],
        [ 1, 147,   0.0],
        [  0.0,   0.0,  65]
    ]),

    "O": scale * np.array([
        [197,  17,   0.0],
        [ 17, 197,   0.0],
        [  0.0,   0.0,  63]
    ]),

    "N": scale * np.array([
        [286, -147.0,   0],
        [-147.0, 286,   2],
        [  2,   2,  95]
    ]),

    "H1": scale * np.array([
        [440, -222, -31],
        [-222, 440, -31],
        [-31, -31, 216]]),
    "H2": scale * np.array([
        [430, -158, 19],
        [-158, 430, 19],
        [19, 19, 140]])
}
#Pour l'hydrogène, on n'a pas de données précises, on peut faire l'approx on suppose que H vibre pareil dans toutes les directions
#Comme H est très léger, il vibre davantage thermiquement (les Odg sont de l'ordre de 0.03–0.08 A˚2)
#e-4 A^2
#est ce qu'ils sont différents en fonction 

#B=8pi^2*(valeur moyenne de U^2) pour chaque atome à T=123K fixée ici

B_database = {k: 8*(math.pi)**2*3.57106*v for k,v in U.items()}


def Bj(j):
    """
    Renvoie le facteur B_j pour un atome j à température T
    """
    try:
        return B_database[j]
    except KeyError:
        raise ValueError(f"B_j non défini pour j={j}, T=123K")


def fonction_exp_DW(G, j):
    """
    Renvoie exp(G^T*-B_j(T,j) * G)
    """
    B = Bj(j)
    mult= G.T @ B @ G
    return np.exp(-mult)


def fonction_expiGr(G, rj):
    """
    Renvoie exp(i*G.rj)
    """
    phase = produit_scalaire(G, rj)
    return np.exp(1j * phase)


def Facteur_de_structure(G, liste_atomes, liste_FD):
    """
    G : vecteur réciproque
    liste_atomes : liste de dictionnaires avec au moins {'position': (x,y,z)}
    liste_FD : liste des f_j(G) correspondants

    Retourne F(G)
    """
    F = 0 + 0j  # complexe

    for j, atome in enumerate(liste_atomes):
        rj = atome["position"]
        fj = liste_FD[j]

        DW = fonction_exp_DW(G, j)
        phase = fonction_expiGr(G, rj)

        F += fj * DW * phase

    return F


